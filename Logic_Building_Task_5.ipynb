        "# Problem 1: Analyze post engagement\n",
        "def analyze_engagement(likes):\n",
        "    print(f\"Total Likes: {likes}\")\n",
        "    if likes >= 1000:\n",
        "        print(\"Post Status: Viral Post\\n\")\n",
        "    else:\n",
        "        print(\"Post Status: Normal Engagement\\n\")\n",
        "\n",
        "# Test the function\n",
        "analyze_engagement(1050)"
      ]
    }
  ]
